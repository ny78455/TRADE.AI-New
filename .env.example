# ============================================================
# TRADE.AI Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ----- Alpaca (Stock & Crypto Trading) -----
APCA_API_KEY_ID=your_alpaca_api_key_here
APCA_API_SECRET_KEY=your_alpaca_secret_key_here
APCA_API_BASE_URL=https://paper-api.alpaca.markets   # paper | https://api.alpaca.markets for live

# ----- Binance -----
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# ----- Google APIs -----
GOOGLE_API_KEY=your_google_api_key_here
SEARCH_ENGINE_ID=your_search_engine_id_here

# ----- App Settings -----
APP_ENV=development                  # development | staging | production
APP_SECRET_KEY=change_me_to_a_secure_random_string_min_32_chars
APP_PORT=8000
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ----- JWT Auth -----
JWT_SECRET_KEY=change_me_to_a_secure_random_jwt_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ----- Redis (for caching & pub/sub) -----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=                      # Leave blank if no password

# ----- Risk Management Defaults -----
RISK_MAX_POSITION_SIZE_USD=10000
RISK_MAX_DAILY_LOSS_PCT=5.0          # Circuit breaker: halt if daily P&L drops below -5%
RISK_MAX_OPEN_ORDERS=10
RISK_MAX_ORDERS_PER_SECOND=5

# ----- Model Paths -----
MODEL_PATH=artifacts/model.h5
FAISS_INDEX_PATH=faiss_index.index
SBERT_MODEL_PATH=sbert_model
ARTIFACTS_DIR=artifacts

# ----- Trading Defaults -----
DEFAULT_TICKER=AVAXUSDT
DEFAULT_INTERVAL=1MINUTE
DEFAULT_PERIOD=10 day
SCHEDULER_REFRESH_SECONDS=8
